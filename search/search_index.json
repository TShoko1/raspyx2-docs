043e\u0439 \u043d\u0430\u0433\u0440\u0443\u0437\u043a\u0435 \u043c\u043e\u0436\u0435\u0442 \u0434\u043e\u0441\u0442\u0438\u0433\u0430\u0442\u044c 2-3 \u0441\u0435\u043a\u0443\u043d\u0434</li> </ul>"},{"location":"current-state/limitations/#_3","title":"\u0424\u0443\u043d\u043a\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u043e\u0441\u0442\u044c","text":"<ul> <li>\u041d\u0435 \u0432\u0441\u0435 \u044d\u043d\u0434\u043f\u043e\u0438\u043d\u0442\u044b \u0440\u0435\u0430\u043b\u0438\u0437\u043e\u0432\u0430\u043d\u044b (\u043e\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0443\u0435\u0442 \u0443\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u0435 \u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u044f\u043c\u0438)</li> <li>\u041e\u0433\u0440\u0430\u043d\u0438\u0447\u0435\u043d\u043d\u0430\u044f \u0444\u0438\u043b\u044c\u0442\u0440\u0430\u0446\u0438\u044f \u0434\u0430\u043d\u043d\u044b\u0445 \u043f\u043e \u0434\u0430\u0442\u0430\u043c</li> <li>\u041d\u0435\u0442 \u043f\u0430\u043a\u0435\u0442\u043d\u044b\u0445 \u043e\u043f\u0435\u0440\u0430\u0446\u0438\u0439</li> </ul>"},{"location":"current-state/limitations/#_4","title":"\u0411\u0435\u0437\u043e\u043f\u0430\u0441\u043d\u043e\u0441\u0442\u044c","text":"<ul> <li>\u0411\u0430\u0437\u043e\u0432\u0430\u044f \u0430\u0443\u0442\u0435\u043d\u0442\u0438\u0444\u0438\u043a\u0430\u0446\u0438\u044f \u043f\u043e \u0442\u043e\u043a\u0435\u043d\u0430\u043c</li> <li>\u041e\u0433\u0440\u0430\u043d\u0438\u0447\u0435\u043d\u043d\u044b\u0435 \u043f\u0440\u0430\u0432\u0430 \u0434\u043e\u0441\u0442\u0443\u043f\u0430 \u0434\u043b\u044f \u0440\u0430\u0437\u043d\u044b\u0445 \u0440\u043e\u043b\u0435\u0439</li> <li>\u041d\u0435\u0442 \u0434\u0432\u0443\u0445\u0444\u0430\u043a\u0442\u043e\u0440\u043d\u043e\u0439 \u0430\u0443\u0442\u0435\u043d\u0442\u0438\u0444\u0438\u043a\u0430\u0446\u0438\u0438</li> </ul>"},{"location":"current-state/limitations/#_5","title":"\u0414\u0430\u043d\u043d\u044b\u0435","text":"<ul> <li>\u041a\u044d\u0448\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435 \u0434\u0430\u043d\u043d\u044b\u0445 \u043e\u0433\u0440\u0430\u043d\u0438\u0447\u0435\u043d\u043e 1 \u0447\u0430\u0441\u043e\u043c</li> <li>\u041d\u0435\u0442 \u0438\u0441\u0442\u043e\u0440\u0438\u0438 \u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u0439 \u0440\u0430\u0441\u043f\u0438\u0441\u0430\u043d\u0438\u044f</li> <li>\u041e\u0433\u0440\u0430\u043d\u0438\u0447\u0435\u043d\u043d\u0430\u044f \u043f\u043e\u0434\u0434\u0435\u0440\u0436\u043a\u0430 \u043f\u043e\u0432\u0442\u043e\u0440\u044f\u044e\u0449\u0438\u0445\u0441\u044f \u0441\u043e\u0431\u044b\u0442\u0438\u0439</li> </ul>"},{"location":"documentation/quickstart/","title":"\u0411\u044b\u0441\u0442\u0440\u044b\u0439 \u0441\u0442\u0430\u0440\u0442","text":"<p>\u041d\u0430\u0447\u043d\u0438\u0442\u0435 \u0440\u0430\u0431\u043e\u0442\u0443 \u0441 API \u0437\u0430 5 \u043c\u0438\u043d\u0443\u0442.</p>"},{"location":"documentation/api-reference/authentication/","title":"\u0410\u0443\u0442\u0435\u043d\u0442\u0438\u0444\u0438\u043a\u0430\u0446\u0438\u044f","text":""},{"location":"documentation/api-reference/authentication/#_2","title":"\u041f\u043e\u043b\u0443\u0447\u0435\u043d\u0438\u0435 \u0442\u043e\u043a\u0435\u043d\u0430","text":"<p>\u0414\u043b\u044f \u043f\u043e\u043b\u0443\u0447\u0435\u043d\u0438\u044f \u0442\u043e\u043a\u0435\u043d\u0430 \u0432\u044b\u043f\u043e\u043b\u043d\u0438\u0442\u0435 \u0437\u0430\u043f\u0440\u043e\u0441:</p> <pre><code>curl -X 'POST' \\\n  'https://zefixed.ru/raspyx/api/v1/users/login' \\\n  -H 'accept: application/json' \\\n  -H 'Content-Type: application/json' \\\n  -d '{\n  \"password\": \"YWNjZXNzdG9hcGk=\",\n  \"username\": \"accesstoapi\"\n}'\n</code></pre> <p>\u0412 \u043e\u0442\u0432\u0435\u0442 \u0432\u044b \u043f\u043e\u043b\u0443\u0447\u0438\u0442\u0435 JWT \u0442\u043e\u043a\u0435\u043d:</p> <pre><code>{\n  \"status\": \"OK\",\n  \"response\": {\n    \"token\": \"eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJhY2Nlc3NfbGV2ZWwiOjUwLCJleHAiOjE3NjQzNTcyNDgsInN1YiI6ImFjY2Vzc3RvYXBpIn0.pYalhMoYqrHzKEj7MadRE5XJT4arFExp2gzfazcVU10\",\n    \"token_type\": \"bearer\"\n  }\n}\n</code></pre>"},{"location":"documentation/api-reference/authentication/#_3","title":"\u0418\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043d\u0438\u0435 \u0442\u043e\u043a\u0435\u043d\u0430","text":"<p>\u0414\u043e\u0431\u0430\u0432\u044c\u0442\u0435 \u043f\u043e\u043b\u0443\u0447\u0435\u043d\u043d\u044b\u0439 \u0442\u043e\u043a\u0435\u043d \u0432 \u0437\u0430\u0433\u043e\u043b\u043e\u0432\u043e\u043a Authorization:</p> <pre><code>GET https://zefixed.ru/raspyx/api/v1/groups\nAuthorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...\n\n\u041f\u0440\u0438\u043c\u0435\u0440 \u0441 curl:\n\ncurl -X GET \"https://zefixed.ru/raspyx/api/v1/groups\" \\\n  -H \"Authorization: Bearer \u0432\u0430\u0448_\u0442\u043e\u043a\u0435\u043d_\u0437\u0434\u0435\u0441\u044c\"\n</code></pre>"},{"location":"documentation/api-reference/overview/","title":"\u041e\u0431\u0437\u043e\u0440 API","text":"<p>REST API \u0434\u043b\u044f \u0441\u0438\u0441\u0442\u0435\u043c\u044b \u0443\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u044f \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0441\u043a\u0438\u043c \u0440\u0430\u0441\u043f\u0438\u0441\u0430\u043d\u0438\u0435\u043c.</p> <p>https://zefixed.ru/raspyx/api/v1</p>"},{"location":"documentation/api-reference/endpoints/groups/","title":"\u0413\u0440\u0443\u043f\u043f\u044b (Groups)","text":"<p>\u0423\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u0435 \u0443\u0447\u0435\u0431\u043d\u044b\u043c\u0438 \u0433\u0440\u0443\u043f\u043f\u0430\u043c\u0438.</p>"},{"location":"documentation/api-reference/endpoints/groups/#_1","title":"\u042d\u043d\u0434\u043f\u043e\u0438\u043d\u0442\u044b","text":"\u041c\u0435\u0442\u043e\u0434 \u041f\u0443\u0442\u044c \u041e\u043f\u0438\u0441\u0430\u043d\u0438\u0435 <code>POST</code> <code>/api/v1/groups</code> \u0421\u043e\u0437\u0434\u0430\u0